# ProofLedger AI — Environment Configuration
# Copy this file to .env and provide your credentials when ready.
# Do NOT commit .env to version control.

# Nebius Token Factory API Configuration
# Base URL verified from official documentation: https://docs.tokenfactory.nebius.com/api-reference/examples/text-generation
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Nebius API Key (Obtain from Nebius Token Factory Console)
NEBIUS_API_KEY=

# NVIDIA Open-Source Model on Nebius Token Factory
# Verified available model: nvidia/Llama-3.1-Nemotron-70B-Instruct
NEBIUS_MODEL_ID=nvidia/Llama-3.1-Nemotron-70B-Instruct

# Master Switch for Live Cloud AI Calls
# Keep false for local demo / test mode. Set to true only with valid credentials.
ALLOW_LIVE_AI=false

# Allowed Client Origin for CORS Security
APP_ALLOWED_ORIGIN=http://localhost:5173

# Server Port
PORT=3001

# Supabase Configuration (Optional - for private cloud history & Google OAuth)
# 100% Free tier compatible. If not configured, app functions seamlessly in Guest Mode.
# Supply your Supabase Project URL and browser publishable key (anon key or modern sb_publishable_... key).
# NEVER use service_role / secret keys here!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
